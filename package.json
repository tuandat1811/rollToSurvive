{
  "name": "roll-to-survive",
  "private": true,
  "type": "module",
  "workspaces": ["server", "client"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "sim": "npm run sim -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "content:export": "npm run content:export -w server",
    "content:import": "npm run content:import -w server --",
    "content:template": "npm run content:template -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
